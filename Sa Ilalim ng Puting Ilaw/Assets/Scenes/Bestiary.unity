  m_Script: {fileID: 11500000, guid: a33c617e5b2f1fc41b38fca7452f51e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  creatureImage: {fileID: 21894233}
  creatureName: {fileID: 98295025}
  creatureDescription: {fileID: 41055488}
  creatures:
  - creatureName: Sigbin
    description: The Sigbin is a creature said to come out at night to suck the blood
      of victims from their shadows.
    image: {fileID: 21300000, guid: fc2a7cbc192ad024fb27e660acaa3efa, type: 3}
  - creatureName: Kapre
    description: 'The Kapre is described as a tree giant or ape like, being a tall,
      dark-coloured, hairy, and muscular creature. '
    image: {fileID: 21300000, guid: d601f5de76366e44092a56921a290ef1, type: 3}
  - creatureName: Tikbalang
    description: Tikbalangs scare travelers, lead them astray and play tricks on
      them such as making them return to an arbitrary path no matter how far they
      go or turn.
    image: {fileID: 21300000, guid: 4409649f9f122b34cb6643ccec4d81ba, type: 3}
  - creatureName: Aswang
    description: Aswang commonly dwell at night in locations such as cemeteries and
      woods, as their powers are significantly, or sometimes totally, reduced during
      the daytime.
    image: {fileID: 21300000, guid: 2c5ba9484a21d6047af83b8de4dbb8a4, type: 3}
  - creatureName: Bakunawa
    description: The Bakunawa is a colossal serpent-like dragon. Known as the "Moon-Eater"
      or "Eclipse Bringer", it is famous for attempting to devour the seven moons.
    image: {fileID: 21300000, guid: 0766e6b0867031f4caa2f398ac4e466c, type: 3}
